# Optional override for the TideWise FastAPI backend URL.
# Leave unset in development to use the Vite proxy on http://localhost:5173 -> http://localhost:8000.
# VITE_API_BASE_URL=http://localhost:8000
# The Vercel deploy sets VITE_API_URL (e.g. https://tidewise-api.onrender.com); either name works.
# VITE_API_URL=
