# Optional override for the TideWise FastAPI backend URL.
# Leave unset in development to use the Vite proxy on http://localhost:5173 -> http://localhost:8000.
# VITE_API_BASE_URL takes precedence; VITE_API_URL is the Render/Vercel fallback.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_URL=http://localhost:8000

# Truthy values (1, true, yes, on) skip the network and always show labeled
# example data in preview mode. Useful for demos and offline work.
# VITE_FORCE_PREVIEW=true
