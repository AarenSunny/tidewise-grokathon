# Copy to .env for local development. Never commit .env.

APP_NAME=TideWise
APP_ENV=development
# Default OFF — required for /debug/* (review1-#15)
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated CORS allowlist (Vite dev). No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# xAI Grok (OpenAI-compatible). Required for IntentBot + ExplainerBot.
XAI_API_KEY=
GROK_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# NWS asks clients to identify themselves with a User-Agent.
NWS_USER_AGENT=TideWise/0.1 (https://github.com/AarenSunny/tidewise-grokathon)

# Official public endpoints (override for tests / failover drills)
NWS_API_BASE_URL=https://api.weather.gov
NOAA_COOPS_API_BASE_URL=https://api.tidesandcurrents.noaa.gov/api/prod/datagetter
NDBC_BASE_URL=https://www.ndbc.noaa.gov

# Resilience defaults
UPSTREAM_TIMEOUT_S=8
UPSTREAM_MAX_RETRIES=3
CACHE_DEFAULT_TTL_SECONDS=300
ORCHESTRATOR_DEADLINE_S=20
ORCHESTRATOR_MAX_CONCURRENCY=8
