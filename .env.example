# Copy to .env for local development. Do not put secrets in this example.

APP_NAME=Tidewise
APP_ENV=development
APP_PORT=3000
API_PORT=3001

# NWS asks clients to identify themselves with an application/contact User-Agent.
# Replace with a real public project URL or monitored team contact before demoing.
NWS_USER_AGENT=Tidewise/0.1 (https://github.com/AarenSunny/tidewise-grokathon)

# Official public endpoints. Keeping these configurable makes adapter testing and
# controlled fallback behavior easier.
NWS_API_BASE_URL=https://api.weather.gov
NOAA_COOPS_API_BASE_URL=https://api.tidesandcurrents.noaa.gov/api/prod/datagetter
USGS_WATER_API_BASE_URL=https://api.waterdata.usgs.gov

# Cache and resilience defaults; tune per product and document exceptions.
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_RETRIES=2
CACHE_DEFAULT_TTL_SECONDS=300
LAST_KNOWN_GOOD_MAX_AGE_SECONDS=1800

# Optional provider credentials belong only in .env, never in source control.
# OPTIONAL_PROVIDER_API_KEY=

